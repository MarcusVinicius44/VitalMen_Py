{
  "version": 2,
  "builds": [
    { "src": "backend/main.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend/main.py" }
  ],
  
 "builds": [
   {
     "src": "api/index.py",
     "use": "@vercel/python"
   }
 ],
 "routes": [
   {
     "src": "/(.*)",
     "dest": "api/index.py"
   }
 ]
}


